{
  "mcpServers": {
    "nba-stats": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-nba-stats"],
      "env": {
        "NBA_STATS_API_BASE": "https://stats.nba.com/stats",
        "NBA_STATS_RATE_LIMIT": "10"
      },
      "tools": [
        "get_player_stats",
        "get_team_stats",
        "get_game_log",
        "get_league_standings",
        "get_player_game_log",
        "get_team_game_log",
        "get_scoreboard",
        "get_player_info",
        "get_team_roster"
      ]
    },
    "odds-api": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-odds-api"],
      "env": {
        "ODDS_API_KEY": "${ODDS_API_KEY}",
        "ODDS_API_BASE": "https://api.the-odds-api.com/v4",
        "ODDS_REGIONS": "us",
        "ODDS_MARKETS": "h2h,spreads,totals"
      },
      "tools": [
        "get_odds",
        "get_live_odds",
        "get_historical_odds",
        "get_scores",
        "get_sports",
        "get_events",
        "get_event_odds"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "env": {
        "POSTGRES_HOST": "${POSTGRES_HOST:-localhost}",
        "POSTGRES_PORT": "${POSTGRES_PORT:-5432}",
        "POSTGRES_DB": "${POSTGRES_DB:-sports_betting}",
        "POSTGRES_USER": "${POSTGRES_USER}",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}"
      },
      "tools": [
        "query",
        "execute",
        "list_tables",
        "describe_table",
        "list_databases"
      ]
    }
  }
}
